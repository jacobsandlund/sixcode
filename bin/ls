#!/bin/bash -e

# Edit this while undergoing sweeping changes, for selecting only
# specific modules
src=$(grep -v '#' <<-SRC
    src/camera
    src/engine
    src/gpu
    src/log
    src/main.c
    src/math
    src/model
    src/os
    src/render
    src/resource
    src/spacetime.h
    src/string
    src/world
SRC
)

exclude_mac='mac/|metal/'
exclude_windows='windows/|directx/'

if [[ "$OSTYPE" == "darwin"* ]]; then
    exclude=$exclude_windows
else
    exclude=$exclude_mac
fi

include_only='.'

for arg in "$@"; do
    case "$arg" in
    all)
        exclude='do_not_exclude_anything'
        ;;
    docker)
        exclude="$exclude_mac|$exclude_windows"
        ;;
    test)
        include_only='test\.c|test\.m$'
        ;;
    code)
        exclude="$exclude|-test.c|-test.m|-mock.c"
        ;;
    *)
        if [ -d "$arg" ]; then
            src="$arg"
        else
            include_only="$arg$"
        fi
        ;;
    esac
done

find $src -type f | grep -E '\.[chm]|\.metal$' | grep -E "$include_only" | grep -Ev "$exclude" | sort
