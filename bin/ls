#!/bin/bash -e

# Edit this while undergoing sweeping changes, for selecting only
# specific modules
src=$(grep -v '#' <<-SRC
    src/camera
    # src/engine
    # src/gpu
    src/log
    src/main.c
    src/math
    src/model
    # src/os
    src/render
    src/resource
    src/spacetime.h
    src/string
    src/world
SRC
)

if [[ $1 == 'all' ]]; then
    exclude='do_not_exclude_anything'
    shift
elif [[ "$OSTYPE" == "darwin"* ]]; then
    exclude='windows/|directx/'
else
    exclude='mac/|metal/'
fi

include_only='.'

if [[ $1 == 'test' ]]; then
    include_only='test\.c|test\.m$'
elif [[ $1 == 'code' ]]; then
    exclude="$exclude|-test.c|-test.m|-mock.c"
elif [[ $# -eq 1 ]]; then
    include_only="$1$"
fi

find $src -type f | grep -E '\.[chm]|\.metal$' | grep -E "$include_only" | grep -Ev "$exclude" | sort
