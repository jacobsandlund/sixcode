#!/bin/bash -e

# Edit this while undergoing sweeping changes, for selecting only
# specific modules
src=$(grep -v '#' <<-SRC
    src/camera
    src/engine
    src/gpu
    src/log
    src/main.c
    src/math
    src/model
    src/os
    src/render
    src/resource
    src/spacetime.h
    src/string
    src/world
SRC
)

if [[ "$OSTYPE" == "darwin"* ]]; then
    exclude='windows/'
else
    exclude='mac/'
fi

include_only='.'

if [[ $1 == 'all' ]]; then
    shift
elif [[ $1 != 'test.c' ]] && [[ $1 != 'test.m' ]] && [[ $1 != test ]]; then
    exclude="$exclude|-test.c|-test.m|mock.c"
fi

if [[ $1 == 'test' ]]; then
    include_only='test\.c|test\.m$'
elif [[ $# -eq 1 ]]; then
    include_only="$1$"
fi

find $src -type f | grep -E '\.[chm]|\.metal$' | grep -E "$include_only" | grep -Ev "$exclude" | sort
