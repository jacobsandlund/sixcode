echo
echo "Commands:"
echo "    bin/all                Make, test, and run valgrind"
echo "    bin/make               Make core.js/wasm with emscripten"
echo "    bin/docker-run         Run the development docker file"
echo "    bin/docker-build       Build the development docker image"
echo "    bin/docker-exec <cmd>  Execute the command in docker container"
echo "    bin/test [<file>]      Test all files (or specified file)"
echo "    bin/valgrind [<file>]  Run files (or file) through Valgrind"
echo "    bin/run <file>         Compile and then run file"
echo "    bin/help               Display this help"
