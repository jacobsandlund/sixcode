#!/bin/bash -e

if [[ $1 == 'help' ]]; then
    echo 'Usage: st help [command]              Display this help, or help for command'
    exit 0
fi

if [[ $# -eq 1 ]]; then
    $SPACETIME_PATH/bin/$1 help
    exit 0
fi

echo 'Usage:' 'st <command> [args*]'
echo
echo 'Commands:'

grep 'Usage:[ ]' $(ls $SPACETIME_PATH/bin/* | sort) | sed -e 's#.*Usage:[ ]st #    #' -e "s/'$//"
