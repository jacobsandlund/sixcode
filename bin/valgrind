#!/bin/bash -e

valgrind_single() {
    test_file="${@: -1}"
    options_length=$(($#-1))
    options=${@:1:$options_length}

    bin/compile $test_file
    valgrind --suppressions=development/valgrind-suppressions.supp --log-fd=1 $options ./a.out |
        cut -d' ' -f 2-
    rm a.out
}

if [ "$#" -eq 0 ] || [ ! -f ${@: -1} ]; then
    for test_file in $(find . -name '*-test.c'); do
        output_file="valgrind-output/$test_file.txt"
        echo ./sixc valgrind "$@" $test_file > $output_file
        echo >> $output_file
        valgrind_single "$@" $test_file >> $output_file
    done

    git diff --exit-code valgrind-output/
else
    valgrind_single "$@"
fi
