#!/bin/bash -e

out="$SPACETIME_PATH/out"

valgrind_single() {
    test_file="${@: -1}"
    options_length=$(($#-1))
    options=${@:1:$options_length}
    output_file="$out/valgrind-output/$test_file.txt"
    echo bin/valgrind "$@" > $output_file
    echo >> $output_file

    $SPACETIME_PATH/bin/compile $test_file
    valgrind --log-fd=1 $options ./a.out |
        cut -d' ' -f 2- | tee -a $output_file
    rm a.out
}

trap "rm -f a.out" EXIT

mkdir -p $out/valgrind-output

if [ "$#" -eq 0 ] || [ ! -f ${@: -1} ]; then
    rm -rf $out/valgrind-output-previous
    cp -R $out/valgrind-output $out/valgrind-output-previous

    for test_file in *-test.c; do
        echo bin/valgrind "$@" $test_file
        valgrind_single "$@" $test_file >> /dev/null
    done

    for output_file in $out/valgrind-output/*; do
        echo "Checking $output_file"
        if grep -E '( lost: [1-9])|(ERROR SUMMARY: [1-9])' $output_file; then
            echo
            echo '!! NOT CLEAN'
            exit 1
        fi
    done

    git --no-pager diff --no-index $out/valgrind-output-previous/ $out/valgrind-output
else
    valgrind_single "$@"
fi
