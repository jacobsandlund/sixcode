#!/bin/bash -e

trap "rm -f a.out" EXIT

run() {
    $SPACETIME_PATH/bin/compile "$@" && ./a.out
}

if [ "$#" -gt 1 ] && [[ $1 == "--no-diff" ]]; then
    shift
    run "$@"
elif [ "$#" -eq 1 ]; then
    run "$@" && git diff --exit-code -- $1
else
    for test_file in $SPACETIME_PATH/src/*-test.c; do
        echo bin/test $test_file
        run $test_file
    done

    git diff --exit-code -- $SPACETIME_PATH/src/*-test.c
fi
