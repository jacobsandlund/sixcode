#!/bin/bash -e

if [[ $1 == 'help' ]]; then
    echo 'Usage: st build [release|debug|clean] Build Spacetime executable'
    exit 0
fi

if [[ $1 == "release" ]] || [[ $1 == "Release" ]]; then
    configuration="Release"
    shift
elif [[ $1 == "debug" ]] || [[ $1 == "Debug" ]]; then
    configuration="Debug"
    shift
elif [[ $1 == "clean" ]]; then
    out="$SPACETIME_PATH/out"
    rm -rf "$out/Debug"
    rm -rf "$out/Release"
    rm -rf "$out/Spacetime.build"
    rm -rf "$out/XCBuildData"
    exit 0
elif [ "$#" -eq 0 ]; then
    configuration="Debug"
else
    echo "Unknown command: $1"
    exit 1
fi

xcodebuild -scheme Spacetime build -configuration "$configuration" "$@"
